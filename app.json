{
  "expo": {
    "name": "Yap Fantasy",
    "slug": "yap-fantasy",
    "version": "0.1.0",
    "description": "Open packs. Set your lineup. Win the week.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yapfantasy",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.yapfantasy.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101114",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yapfantasy.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "42236604-eb1e-45fe-8fb1-4f6929a0bdb6"
      }
    },
    "owner": "nickroachy",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/42236604-eb1e-45fe-8fb1-4f6929a0bdb6",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
