{
  "name": "yap-fantasy",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "@expo/ui": "~57.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.14",
    "expo-constants": "~57.0.12",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "check:functions": "deno check supabase/functions/**/index.ts supabase/tests/*.ts",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:sql -- --skip-without-db",
    "test:unit": "node scripts/run-deno-tests.mjs",
    "test:sql": "node scripts/run-sql-tests.mjs",
    "smoke:provider": "deno run --allow-net --allow-env --allow-read supabase/tests/provider_smoke.ts",
    "gen:types": "supabase gen types typescript --linked > src/lib/database.types.ts"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  }
}
